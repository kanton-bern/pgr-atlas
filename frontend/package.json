    "build": "node build.js",
    "dev:watch": "node build.js --watch"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "maplibre-gl": "6.19.0",
    "pmtiles": "4.5.0",
    "proj4": "2.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/geojson": "7946.0.16",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
